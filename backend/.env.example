# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Google OAuth 2.0 (Calendar + Gmail) ─────────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
# base64 encode your service account JSON:
#   base64 -w 0 service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=base64-encoded-service-account-json
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# ── Google Speech-to-Text ────────────────────────────────────────────────────
# Leave blank to use GEMINI_API_KEY for STT as well
GOOGLE_SPEECH_API_KEY=

# ── Cloud SQL (PostgreSQL) ───────────────────────────────────────────────────
# Local dev:
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/lifesaver
# Cloud Run (Cloud SQL Auth Proxy via Unix socket):
# DATABASE_URL=postgresql+asyncpg://user:password@/lifesaver?host=/cloudsql/PROJECT:REGION:INSTANCE

# ── Cloud Storage ─────────────────────────────────────────────────────────────
GCS_BUCKET_NAME=lifesaver-uploads
GCP_PROJECT_ID=your-gcp-project-id

# ── App ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
SECRET_KEY=change-this-to-a-random-secret-in-production
INTERNAL_API_SECRET=change-this-too-for-cloud-scheduler-auth
DEBUG=false
